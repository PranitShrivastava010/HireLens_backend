// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String
  password            String
  isVerified          Boolean  @default(false)
  hasCompletedPref    Boolean @default(false)
  weeklyGoal          Int     @default(10)
  createdAt           DateTime @default(now())

  rolePreferences     UserRolePreference[]
  skillPreferences    UserSkillPreference[]

  tokens     UserToken[]
  resume     Resume[]
  atsAnalysis AtsAnalysis[]

  applications JobApplication[]
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model UserToken {
  id               String   @id @default(uuid())
  userId           String
  refreshToken     String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Jobs {
  id                     String   @id @default(uuid())

  providerJobId          String   @unique
  providerName           String

  title                  String
  description            String
  employmentType         String
  isRemote               Boolean  @default(false)

  companyName            String
  companyLogo            String?
  companyWebsite         String?

  location               String
  city                   String?
  state                  String?
  country                String?

  applyUrl               String

  minSalary              Int?
  maxSalary              Int?
  salaryPeriod           SalaryPeriod?

  minExperienceYears     Int?
  maxExperienceYears     Int?
  experienceRaw          String[] @db.Text

  qualifications         String[] @db.Text
  responsibilities       String[] @db.Text

  postedAt               String?
  postedAtUtc            DateTime?

  applyStatus            Boolean  @default(false)

  lastFetchedAt          DateTime @default(now())
  enrichmentStatus       JobEnrichmentStatus @default(PENDING)
  enrichmentQueuedAt     DateTime @default(now())
  enrichmentStartedAt    DateTime?
  enrichedAt             DateTime?
  enrichmentAttempts     Int      @default(0)
  enrichmentLastError    String?

  createdAt              DateTime @default(now())

  applications           JobApplication[]
  keyword                JobKeyword[]
  atsAnalysis            AtsAnalysis[]
  jobRoles               JobRole[]
  jobSkills              JobSkill[]

  @@index([title])
  @@index([companyName])
  @@index([location])
  @@index([isRemote])
  @@index([postedAtUtc])
  @@index([postedAtUtc, lastFetchedAt])
  @@index([lastFetchedAt])
  @@index([minSalary])
  @@index([maxSalary])
  @@index([minExperienceYears])
  @@index([maxExperienceYears])
  @@index([enrichmentStatus, enrichmentQueuedAt])
}

enum SalaryPeriod {
  HOUR
  MONTH
  YEAR
}

enum FetchCategory {
  ENGINEERING
  PRODUCT
  HR
  DATA
  DESIGN
  SALES
  MARKETING
  OPERATIONS
  FINANCE
}

enum JobEnrichmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum JobPipelineStage {
  FETCH
  ENRICH
}

enum FetchRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

enum FetchTriggerType {
  CRON
  MANUAL
}

enum JobFetchRunItemType {
  TARGET
  JOB
}

model Role {
  id             String @id @default(uuid())
  name           String @unique
  slug           String @unique
  createdAt      DateTime @default(now())

  aliases        RoleAlias[]
  jobs           JobRole[]
  rolePreferences UserRolePreference[]
  fetchTargets   JobFetchTargetRole[]
}

model RoleAlias {
  id             String @id @default(uuid())
  roleId         String
  alias          String @unique

  role          Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([alias])
  @@index([roleId])
}

model Skill {
  id             String @id @default(uuid())
  name           String @unique
  slug           String @unique
  createdAt      DateTime @default(now())

  aliases        SkillAlias[]
  jobs           JobSkill[]
  skillPreferences UserSkillPreference[]
}

model SkillAlias {
  id             String @id @default(uuid())
  skillId        String
  alias          String @unique

  skill          Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([alias])
  @@index([skillId])
}

model JobRole {
  jobId          String
  roleId         String

  job            Jobs @relation(fields: [jobId], references: [id], onDelete: Cascade)
  role           Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([jobId, roleId])
}

model JobSkill {
  jobId         String
  skillId       String

  job           Jobs @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill         Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

model UserRolePreference {
  userId        String
  roleId        String

  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserSkillPreference {
  userId        String
  skillId       String

  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill         Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model JobFetchTarget {
  id                  String   @id @default(uuid())
  name                String   @unique
  query               String   @unique
  category            FetchCategory?
  isActive            Boolean  @default(true)
  priority            Int      @default(100)
  demandScore         Int      @default(0)
  refreshEveryMinutes Int      @default(360)
  lastFetchedAt       DateTime?
  nextRunAt           DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  failureCount        Int      @default(0)
  cooldownUntil       DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  roles               JobFetchTargetRole[]
  runItems            JobFetchRunItem[]

  @@index([isActive, nextRunAt])
  @@index([priority, demandScore])
}

model JobFetchTargetRole {
  targetId        String
  roleId          String

  target          JobFetchTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  role            Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([targetId, roleId])
}

model JobFetchRun {
  id              String           @id @default(uuid())
  stage           JobPipelineStage @default(FETCH)
  status          FetchRunStatus   @default(RUNNING)
  triggerType     FetchTriggerType @default(CRON)
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  durationMs      Int?
  itemsPlanned    Int              @default(0)
  itemsProcessed  Int              @default(0)
  jobsFetched     Int              @default(0)
  jobsCreated     Int              @default(0)
  jobsUpdated     Int              @default(0)
  jobsFailed      Int              @default(0)
  errorMessage    String?
  createdAt       DateTime         @default(now())

  items           JobFetchRunItem[]

  @@index([stage, startedAt])
}

model JobFetchRunItem {
  id              String              @id @default(uuid())
  runId           String
  targetId        String?
  itemType        JobFetchRunItemType @default(TARGET)
  label           String
  query           String?
  status          FetchRunStatus      @default(RUNNING)
  startedAt       DateTime            @default(now())
  endedAt         DateTime?
  durationMs      Int?
  jobsFetched     Int                 @default(0)
  jobsCreated     Int                 @default(0)
  jobsUpdated     Int                 @default(0)
  jobsFailed      Int                 @default(0)
  errorMessage    String?

  run             JobFetchRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  target          JobFetchTarget?     @relation(fields: [targetId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([targetId])
}

model ApplicationStatus {
  id    String @id @default(uuid())
  key   String @unique
  label String
  sortOrder   Int
  allowsDate  Boolean @default(false)

  createdAt DateTime @default(now())

  applications JobApplication[]
}

model JobApplication {
  id            String   @id @default(uuid())
  userId        String
  jobId         String
  statusId      String

  interviewDate DateTime?
  appliedAt     DateTime @default(now())

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  job    Jobs   @relation(fields: [jobId], references: [id])
  status ApplicationStatus @relation(fields: [statusId], references: [id])

  @@unique([userId, jobId])
  @@index([statusId])
  @@index([userId, appliedAt])
  @@index([userId, statusId, interviewDate])
}

model JobKeyword {
  id              String   @id @default(uuid())
  jobId           String
  keyword          String
  score           Float

  type            KeywordType @default(ATOMIC)
  aliases         String[]    @default([])

  createdAt       DateTime @default(now())

  job             Jobs @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([keyword])
}

enum KeywordType {
  ATOMIC
  CATEGORY
  CONCEPT
}

model Resume {
  id              String @id @default(uuid())
  userId          String
  filePath        String
  extractedText   String

  createdAt       DateTime @default(now())

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  atsAnalysis     AtsAnalysis[]

  @@map("Resume")
  @@index([userId])
}

model AtsAnalysis {
  id            String   @id @default(uuid())
  userId        String
  jobId         String?      // nullable for future role-based ATS
  resumeId      String

  score         Float
  matchedCount  Int
  missingCount  Int

  matchedKeywords String[]
  missingKeywords String[]

  createdAt     DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  job    Jobs?  @relation(fields: [jobId], references: [id])
  resume Resume @relation(fields: [resumeId], references: [id])

  @@index([userId])
  @@index([jobId])
}

model BuildResume {
  id        String   @id @default(uuid())
  userId    String   @unique
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  basics        ResumeBasics?
  experiences   ResumeExperience[]
  educations    ResumeEducation[]
  projects      ResumeProject[]
  skills        ResumeSkill[]
  certifications ResumeCertification[]
  contactLinks  ResumeContactLink[]
  layoutSettings ResumeLayoutSettings?
}

model ResumeBasics {
  id        String  @id @default(uuid())
  resumeId String  @unique

  fullName String
  headline String?
  summary  String?

  email    String?
  phone    String?
  location String?
  linkedin String?
  github   String?

  resume   BuildResume @relation(fields: [resumeId], references: [id])
}

model ResumeExperience {
  id          String   @id @default(uuid())
  resumeId   String

  company     String
  role        String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean @default(false)

  bullets     String[] // achievements

  orderIndex  Int
  resume      BuildResume @relation(fields: [resumeId], references: [id])
}

model ResumeEducation {
  id        String @id @default(uuid())
  resumeId String

  institute String
  degree    String
  field     String?
  startYear Int
  endYear   Int?

  resume BuildResume @relation(fields: [resumeId], references: [id])
}

model ResumeSkill {
  id        String @id @default(uuid())
  resumeId String

  name      String
  level     String? // Beginner / Intermediate / Expert
  category  String? // Backend, Frontend, DevOps

  resume BuildResume @relation(fields: [resumeId], references: [id])
}

model ResumeProject {
  id        String @id @default(uuid())
  resumeId String

  name        String
  description String
  techStack   String[]
  link        String?
  dateLabel   String?

  resume BuildResume @relation(fields: [resumeId], references: [id])
}

model ResumeCertification {
  id        String @id @default(uuid())
  resumeId String

  name       String
  issuer    String
  year      Int?
  link      String?

  resume BuildResume @relation(fields: [resumeId], references: [id])
}

model ResumeContactLink {
  id         String @id @default(uuid())
  resumeId   String
  label      String
  url        String
  orderIndex Int    @default(0)

  resume BuildResume @relation(fields: [resumeId], references: [id])

  @@index([resumeId, orderIndex])
}

model ResumeLayoutSettings {
  id                 String  @id @default(uuid())
  resumeId           String  @unique
  pageMode           String?
  density            String?
  fontSize           Float?
  lineHeight         Float?
  pagePaddingTop     Float?
  pagePaddingBottom  Float?
  pagePaddingX       Float?
  sectionSpacing     Int?
  itemSpacing        Int?
  bulletSpacing      Int?
  showSummary        Boolean @default(true)
  showExperience     Boolean @default(true)
  showProjects       Boolean @default(true)
  showSkills         Boolean @default(true)
  showEducation      Boolean @default(true)
  showCertifications Boolean @default(true)

  resume BuildResume @relation(fields: [resumeId], references: [id])
}

