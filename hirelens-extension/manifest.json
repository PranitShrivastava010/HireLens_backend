{
  "manifest_version": 3,
  "name": "HireLens LinkedIn Discovery",
  "description": "Assisted LinkedIn discovery queue for HireLens outreach contacts.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_title": "HireLens Discovery",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/search/results/people/*"],
      "js": ["content/linkedin-capture.js"],
      "css": ["content/linkedin-capture.css"],
      "run_at": "document_idle"
    }
  ]
}
